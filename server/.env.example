# Copy to server/.env and fill in. Never commit .env.

NODE_ENV=development
PORT=4000

# MongoDB Atlas connection string, or a local MongoDB (e.g. mongodb://localhost:27017/stemotics).
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/stemotics?retryWrites=true&w=majority

# At least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=

# Browser origins allowed to send state-changing requests (CSRF check).
# Production: https://stemotics.com
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# Number of reverse proxies in front of the API (Nginx = 1, none in local dev).
TRUST_PROXY=0

STAFF_IDLE_TIMEOUT_MINUTES=30
STAFF_SESSION_MAX_HOURS=12
PARENT_SESSION_DAYS=30
LOGIN_RATE_LIMIT_PER_15_MIN=20

# Public website address (used in email links).
WEB_URL=http://localhost:5173

# Email: log (print to console, development) | smtp (real sending; required in production).
EMAIL_TRANSPORT=log
# SMTP_URL=smtps://USER:PASSWORD@smtp.example.com:465
EMAIL_FROM=STEMOTICS <info@stemotics.com>

# Payments: "test" shows Approve/Decline buttons instead of card fields. Helcim/Stripe are
# added once STEMOTICS confirms Decision D-1. "test" is refused in production.
PAYMENTS_GATEWAY=test

# Minutes a time-slot seat is held while the parent pays.
SEAT_HOLD_MINUTES=15
